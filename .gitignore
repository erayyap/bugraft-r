# Deny by default: only reviewed code/docs/curated graphics are public.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/pytest.ini
!/bugcraft_bench/
!/computer_use/
!/scripts/
!/tests/
!/docs/
/docs/*
!/docs/protocol.md
!/vm/
/vm/*
!/vm/shared/
/vm/shared/*
!/vm/shared/*.ps1
!/vm/shared/*.cs
!/reports/
/reports/*
!/reports/comparison/
/reports/comparison/*
!/reports/comparison/comparison-data.csv
!/reports/comparison/comparison-data.json
!/reports/comparison/cost_success.png
!/reports/comparison/cost_success.svg
!/reports/comparison/cost_success.pdf
!/reports/comparison/time_success.png
!/reports/comparison/time_success.svg
!/reports/comparison/time_success.pdf
!/reports/comparison/cost_time_success.png
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.env
**/auth.json
**/accounts.json
**/*.jsonl
